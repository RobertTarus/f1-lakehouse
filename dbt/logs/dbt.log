        source_system,
        ingested_at,

        row_number() over (

            partition by

                season,
                event_slug,
                session_type,
                driver_code,
                lap_number,
                sample_time_ms

            order by sample_timestamp_utc

        ) as telemetry_record_number

    from source_telemetry

),

deduplicated as (

    select *

    from validated

    where telemetry_record_number = 1

)

