    tyre_life,
    position,

    telemetry_samples,

    first_sample_timestamp_utc,
    last_sample_timestamp_utc,

    telemetry_start_ms,
    telemetry_end_ms,

    telemetry_duration_ms,
    telemetry_duration_seconds,

    avg_speed_kph,
    min_speed_kph,
    max_speed_kph,
    median_speed_kph,
    p95_speed_kph,

    avg_rpm,
    peak_rpm,
    p95_rpm,

    avg_throttle_pct,
    full_throttle_pct,
    low_throttle_pct,

    braking_samples,
    braking_pct,

    drs_active_samples,
    drs_usage_pct,

    avg_gear,
    min_gear,
    max_gear,

    measured_lap_distance,
    telemetry_distance_m,
    max_relative_distance,

    avg_distance_to_driver_ahead_m,
    min_distance_to_driver_ahead_m,
    distinct_drivers_ahead,

    null_speed_samples,
    null_rpm_samples,
    null_throttle_samples,
    null_gear_samples,

    has_lap_timing,

    current_timestamp
        as gold_generated_at

from combined
