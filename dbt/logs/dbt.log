-- ============================================================

select

    season,
    event_slug,
    session_type,
    driver_code,
    lap_number,
    lap_time_seconds,
    has_lap_timing,
    lap_match_status

from "iceberg"."gold"."lap_telemetry_metrics"

where

    (
        has_lap_timing = true
        and lap_time_seconds is null
    )

